# ── Required for AI scoring + fit analysis ───────────────────────────────────
# OpenRouter — FREE tier available, no credit card needed
# Sign up at https://openrouter.ai → API Keys → Create key
# Free models: meta-llama/llama-3.3-70b-instruct:free, google/gemma-3-27b-it:free
OPENROUTER_API_KEY=your_key_here

# ── Fallback LLM (optional but recommended) ──────────────────────────────────
# Any OpenAI-compatible endpoint. Used when OpenRouter has no key, errors, or
# its free tier is rate-limited, so AI analysis degrades to a second provider
# instead of silently dropping to rule-based scores.
TOKENROUTER_API_KEY=your_key_here
# TOKENROUTER_BASE_URL=https://api.tokenrouter.com/v1
# TOKENROUTER_MODEL=z-ai/glm-5.3-free

# ── Optional: real company discovery (without this, uses mock data) ───────────
# Google Places API — https://console.cloud.google.com
GOOGLE_PLACES_API_KEY=your_key_here

# ── Optional: contact enrichment ─────────────────────────────────────────────
# Hunter.io — https://hunter.io/api-keys
HUNTER_API_KEY=your_key_here

# ── Optional: search history persistence ─────────────────────────────────────
# Without this, searches live only in process memory: a restart (the free Render
# dyno sleeps) loses them and CSV export returns 404.
# Supabase — https://supabase.com
SUPABASE_URL=your_url_here
SUPABASE_KEY=your_key_here
# Service-role key: SERVER ONLY (Render env), never the frontend. The backend
# writes the public archives (cra_actions, news_archive, source_reads) with it;
# the publishable key above can only read them. Supabase -> Project Settings ->
# API Keys -> service_role / secret key.
SUPABASE_SERVICE_KEY=

# ── Optional: CORS + logging ─────────────────────────────────────────────────
# Comma-separated exact origins allowed to call this API. Leave unset to allow
# any *.vercel.app deploy plus localhost, which is what production uses.
# ALLOWED_ORIGINS=https://acer-iq.vercel.app
# DEBUG surfaces every source failure and external call; INFO is the default.
# LOG_LEVEL=INFO
